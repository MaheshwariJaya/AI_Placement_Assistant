# Development Local Environment Settings
APP_NAME="AI-Powered Placement Intelligence System"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=placement_intelligence_local
DB_SCHEMA=placement_app_v2
DATABASE_URL=postgresql+asyncpg://postgres:your_password@127.0.0.1:5432/placement_intelligence_local

DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=15

RESUME_STORAGE_DIR=backend/uploads/resumes
MAX_UPLOAD_SIZE_BYTES=5242880

AI_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=45
AI_MOCK_DELAY_MS=250
AI_MAX_OUTPUT_TOKENS=8192
AI_TEMPERATURE=0.0

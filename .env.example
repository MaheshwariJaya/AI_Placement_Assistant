# ==============================================================================
# AI-Powered Placement Intelligence System — Environment Configuration
# ==============================================================================
# NOTE: This file contains placeholder values only. Copy to .env and configure.
# Never commit real secrets or production passwords to version control.

# --- Application Core Settings ---
APP_NAME="AI-Powered Placement Intelligence System"
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
API_V1_PREFIX=/api/v1
SECRET_KEY=change_this_to_a_random_secure_hex_secret_key_minimum_32_characters
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# --- PostgreSQL Database Settings ---
# Async SQLAlchemy requires the asyncpg driver: postgresql+asyncpg://user:password@host:port/dbname
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=placement_db
DB_SCHEMA=placement_app_v2
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@127.0.0.1:5432/placement_db

# --- Database Pool Configuration ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# --- File Storage & Uploads ---
# Protected path for student resume storage (outside public static root)
RESUME_STORAGE_DIR=backend/uploads/resumes
MAX_UPLOAD_SIZE_BYTES=5242880

# --- AI Provider Configuration ---
# Active provider selector: "mock", "gemini", or "openai"
AI_PROVIDER=mock

# Google Gemini Settings (Used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# OpenAI Settings (Used when AI_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Operational AI Settings
AI_TIMEOUT_SECONDS=15
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.0
AI_MOCK_DELAY_MS=250

